# ──────────────────────────────────────────────────────────────────────────────
# dsh 自托管 — 运行时环境变量模板
#
# 复制为 .env 后按需修改，然后 `docker compose -f compose.yml up -d --build`：
#   cp .env.example .env
#   vi .env
#
# 这些变量由 docker compose 自动读取并注入容器。所有值都有安全默认值，
# 留空即使用默认行为，不会注入任何个人信息。
#
# 构建期变量（DSH_CLIENT_TITLE / DSH_CLIENT_COMMIT_HASH /
# DSH_CLIENT_LOOPBACK_HOSTS）不在此文件中——它们通过 --build-arg 传入，
# 详见 README.md 和 Dockerfile。
# ──────────────────────────────────────────────────────────────────────────────

# syslog UDP 地址（留空则不转发容器日志到远程 syslog）
# 如需完全禁用 syslog，改 compose.yml 中的 logging.driver 为 json-file。
DSH_SYSLOG_ADDRESS=

# 宿主机数据卷路径（默认 ./dsh-data，相对于 compose 项目根目录）
DSH_HOME_HOST_PATH=./dsh-data
